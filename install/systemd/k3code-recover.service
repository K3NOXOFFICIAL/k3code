[Unit]
Description=Recover the k3code daemon after systemd stopped restarting it (start limit hit)

[Service]
Type=oneshot
TimeoutStartSec=infinity
ExecStart=/bin/sh -c 'sleep 1800 && systemctl --user reset-failed k3code.service && systemctl --user start k3code.service'
MemoryMax=64M
TasksMax=16
UMask=0022
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
