{"cmd": "X=/; echo $(rm -rf $X); X=safe", "class": "hardline", "why": "a substitution reads the variable where it runs, not at the end of the line"}
{"cmd": "X=/; Y=$X; rm -rf $Y", "class": "hardline", "why": "a variable copied from a known one"}
{"cmd": "rm -rf ${X:-/}", "class": "hardline", "why": "the default of an expansion"}
{"cmd": "X=safe; read X; rm -rf $X", "class": "needs_human", "why": "read changes the variable"}
{"cmd": "X=safe; eval \"X=/\"; rm -rf $X", "class": "needs_human", "why": "eval changes the variable"}
{"cmd": "rm -rf $X/", "class": "needs_human", "why": "an unset variable makes it the root"}
{"cmd": "rm -rf \"$X\"/*", "class": "needs_human", "why": "an unset variable makes it everything under the root"}
{"cmd": "rm -rf ${A[0]}", "class": "needs_human", "why": "an array element is as unknown as a variable"}
